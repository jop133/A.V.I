# Copie este arquivo para .env e preencha.
# O .env NUNCA deve ser versionado nem compartilhado.
# Este arquivo (.env.exemplo) VAI para o repositorio -- nao ponha chave real aqui.

# Chave da Cartesia (https://play.cartesia.ai -> API Keys)
CARTESIA_API_KEY=sk_car_SUA_CHAVE_AQUI

# ID da voz escolhida. Descubra rodando:
#     .\.venv\Scripts\python.exe listar_vozes_cartesia.py
CARTESIA_VOICE_ID=cole_o_id_da_voz_escolhida_aqui

# Opcionais
CARTESIA_MODEL=sonic-3.6

# Cidade usada quando voce pergunta o clima sem dizer qual.
# Sem isto, o Jarvis descobre sua cidade batendo no ip-api.com --
# que so atende em HTTP puro, sem TLS.
CIDADE_PADRAO=Santa Rita do Sapucai
