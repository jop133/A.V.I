.venv/
__pycache__/
*.pyc

# Segredos: chaves de API
.env

# Token do SSE, sorteado a cada boot -- e o que impede um site qualquer
# aberto no navegador de ler o que o usuario fala pela ponte da HUD.
.hud_token

# Modelos e amostras (pesados, baixados sob demanda)
vozes/*.onnx
vozes/*.onnx.json
vozes/kokoro/
vozes/amostras/
vozes/cache/

*.bak

# Perfil isolado do navegador da HUD (300+ arquivos, inclui cookies e historico)
.hud_profile/

# Copias de trabalho -- o historico do git substitui isso
*.orig

# Log de falhas ao abrir as interfaces (diagnostico local)
.interface_erros.log
